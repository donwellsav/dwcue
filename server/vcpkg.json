{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "liveplay-server",
  "version-string": "2.5.11",
  "description": "DonWells Cue headless audio engine and control server.",
  "homepage": "https://github.com/donwellsav/dwcue",
  "license": "AGPL-3.0-only",
  "dependencies": [
    {
      "name": "nlohmann-json",
      "version>=": "3.11.3"
    },
    {
      "name": "crow",
      "version>=": "1.2.0"
    },
    {
      "name": "taglib",
      "version>=": "2.0"
    },
    {
      "name": "miniaudio",
      "version>=": "0.11.21"
    },
    {
      "name": "miniz",
      "version>=": "3.0.2"
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [
        "avcodec",
        "avformat",
        "openmpt",
        "swresample"
      ]
    },
    {
      "name": "fluidsynth",
      "default-features": false
    },
    {
      "name": "game-music-emu"
    },
    {
      "name": "vgmstream"
    }
  ],
  "builtin-baseline": "22d9c655dc24ad24c6cac27607005e619ce46740"
}
