{
  "name": "donwells-cue",
  "version": "2.5.18",
  "description": "Audio cue playback application for live events",
  "homepage": "https://github.com/donwellsav/dwcue",
  "repository": {
    "type": "git",
    "url": "https://github.com/donwellsav/dwcue.git"
  },
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:nuxt\" \"npm run dev:electron\"",
    "dev:nuxt": "nuxt dev",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "build": "cross-env NODE_ENV=production nuxt generate",
    "build:electron": "cross-env NODE_ENV=production nuxt generate && electron-builder",
    "electron:build": "electron-builder",
    "generate": "cross-env NODE_ENV=production nuxt generate",
    "test:one-shots": "vite-node tests/oneShots.test.mts",
    "preview": "nuxt preview",
    "typecheck": "nuxi typecheck"
  },
  "keywords": [
    "electron",
    "audio",
    "cue",
    "playback",
    "live"
  ],
  "author": "DonWells",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@types/node": "^20.10.5",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "42.8.0",
    "electron-builder": "^26.8.1",
    "nuxt": "^4.4.7",
    "sass": "^1.69.5",
    "typescript": "^5.3.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^3.3.8",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.6.2",
    "extract-zip": "^2.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "material-symbols": "^0.39.1",
    "youtube-search-api": "^2.0.1",
    "yt-dlp-wrap": "^2.3.12"
  },
  "build": {
    "appId": "com.donwells.cue",
    "productName": "DonWells Cue",
    "copyright": "Copyright © 2026 DonWells. Original software © Thomas Doukinitsas and contributors.",
    "artifactName": "DonWells-Cue-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      ".output/**/*",
      "electron/**/*",
      "assets/**/*",
      "locales/**/*"
    ],
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*",
      "node_modules/@ffprobe-installer/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "liveplay",
        "name": "DW Cue Project",
        "description": "DW Cue Project File",
        "role": "Editor",
        "icon": "assets/icons/4092w/liveplay-document@4092px.png"
      },
      {
        "ext": "lpa",
        "name": "DW Cue Archive",
        "description": "DW Cue Project Archive",
        "role": "Editor",
        "icon": "assets/icons/4092w/liveplay-archive@4092.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/4092w/app_icon_darkmode@4092px.png",
      "extraResources": [
        {
          "from": "../server/build/Release",
          "to": "server-bin",
          "filter": [
            "dwcue-server.exe",
            "*.dll"
          ]
        },
        {
          "from": "../server/assets/TimGM6mb.sf2",
          "to": "server-bin/TimGM6mb.sf2"
        },
        {
          "from": "../server/assets/TimGM6mb.NOTICE.md",
          "to": "server-bin/TimGM6mb.NOTICE.md"
        },
        {
          "from": "../server/assets/TimGM6mb.GPL-2.0.txt",
          "to": "server-bin/TimGM6mb.GPL-2.0.txt"
        }
      ]
    },
    "nsis": {
      "guid": "2257174e-d0c0-55d9-b333-78152c976efe",
      "include": "build/installer.nsh",
      "artifactName": "DonWells-Cue-Setup-${version}.${ext}"
    },
    "mac": {
      "sign": "scripts/sign-mac.js",
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.3",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icons/4092w/app_icon_darkmode@4092px.png",
      "category": "public.app-category.music",
      "extraResources": [
        {
          "from": "../server/build/dwcue-server",
          "to": "server-bin/dwcue-server"
        },
        {
          "from": "../server/assets/TimGM6mb.sf2",
          "to": "server-bin/TimGM6mb.sf2"
        },
        {
          "from": "../server/assets/TimGM6mb.NOTICE.md",
          "to": "server-bin/TimGM6mb.NOTICE.md"
        },
        {
          "from": "../server/assets/TimGM6mb.GPL-2.0.txt",
          "to": "server-bin/TimGM6mb.GPL-2.0.txt"
        }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 190,
          "y": 220,
          "type": "file"
        },
        {
          "x": 510,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 700,
        "height": 400
      }
    },
    "linux": {
      "maintainer": "DonWells",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/4092w/app_icon_darkmode@4092px.png",
      "category": "AudioVideo",
      "extraResources": [
        {
          "from": "../server/build/dwcue-server",
          "to": "server-bin/dwcue-server"
        },
        {
          "from": "../server/assets/TimGM6mb.sf2",
          "to": "server-bin/TimGM6mb.sf2"
        },
        {
          "from": "../server/assets/TimGM6mb.NOTICE.md",
          "to": "server-bin/TimGM6mb.NOTICE.md"
        },
        {
          "from": "../server/assets/TimGM6mb.GPL-2.0.txt",
          "to": "server-bin/TimGM6mb.GPL-2.0.txt"
        }
      ]
    }
  }
}
